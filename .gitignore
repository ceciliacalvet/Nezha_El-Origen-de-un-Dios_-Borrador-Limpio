# This .gitignore file should be placed at the root of your Unity project directory
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you have local JetBrains Rider settings to ignore
# .idea/

# Autogenerated VS/MD/Consulo files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta

# Unity3D generated meta files
*.pidb
*.svd

deploy/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon
ehthumbs.db
[Tt]humbs.db

# Visual Studio / MonoDevelop
.vscode/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# Rider
.idea/
*.sln.iml

# User-specific files
*.db
*.mdb
*.bak
*.orig
*.backup
*.tmp
*.temp

# Crash Reports
sysinfo.txt

# Packages
/Packages/packages-lock.json

# Uncomment if you have a local custom package cache folder
# /Library/PackageCache/

# Unity Addressable Asset System
/[Aa]ssets/**/*.bin
/[Aa]ssets/**/*.info

# Build generated files
/[Aa]ssets/StreamingAssets/*

# Uncomment if using shader cache
# /Library/ShaderCache/

# JetBrains Rider
.idea/
*.sln.iml

# Rider local settings
.idea/
*.sln.iml

# Unity Generated files
/[Aa]ssets/**/*.csproj
/[Aa]ssets/**/*.unityproj
/[Aa]ssets/**/*.sln
/[Aa]ssets/**/*.suo
/[Aa]ssets/**/*.user
/[Aa]ssets/**/*.userprefs

# Local environment files
.env
.local.env

# Custom folder for local tools
/.vs/

# Yarn/NPM logs
yarn-debug.log*
npm-debug.log*
pnpm-debug.log*

# Local build artifacts
/Build/
/Builds/

# Serialized cache
/[Ll]ibrary/
/Temp/
/Obj/

# Memory snapshots
*.memsnap

# Profiling
*.trace

# Generated crash reports
crash.log
crash.dmp

# Temporary and backup files
*~
*.swp
*.swo
*.tmp
*.bak
*.backup
*.orig
